<odoo>
    <record id="view_niyu_sheets_connection_tree" model="ir.ui.view">
        <field name="name">niyu.sheets.connection.list</field>
        <field name="model">niyu.sheets.connection</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="auth_mode"/>
                <field name="service_account_email"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_niyu_sheets_connection_form" model="ir.ui.view">
        <field name="name">niyu.sheets.connection.form</field>
        <field name="model">niyu.sheets.connection</field>
        <field name="arch" type="xml">
            <form string="Google Sheets Connection">
                <header>
                    <button name="action_parse_service_account" type="object" string="Parse Credential" class="btn-primary"/>
                    <button name="action_test_connection" type="object" string="Test Connection"/>
                    <button name="action_generate_token" type="object" string="Generate Webhook Token"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="auth_mode"/>
                        <field name="company_id"/>
                        <field name="service_account_email" readonly="1"/>
                        <field name="webhook_token" readonly="1" password="True"/>
                    </group>
                    <group string="Service Account JSON">
                        <field name="service_account_json" nolabel="1" placeholder="Paste Google service account JSON here"/>
                    </group>
                    <group string="Last Test Result">
                        <field name="last_test_message" readonly="1" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_niyu_sheets_connection" model="ir.actions.act_window">
        <field name="name">Google Sheets Connections</field>
        <field name="res_model">niyu.sheets.connection</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

<odoo>
    <record id="view_niyu_sheets_mapping_tree" model="ir.ui.view">
        <field name="name">niyu.sheets.mapping.list</field>
        <field name="model">niyu.sheets.mapping</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="model_name"/>
                <field name="sheet_name"/>
                <field name="sync_direction"/>
                <field name="last_success_at"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_niyu_sheets_mapping_form" model="ir.ui.view">
        <field name="name">niyu.sheets.mapping.form</field>
        <field name="model">niyu.sheets.mapping</field>
        <field name="arch" type="xml">
            <form string="Google Sheets Mapping">
                <header>
                    <button name="action_enqueue_full_sync" type="object" string="Sync Now" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="key"/>
                            <field name="connection_id"/>
                            <field name="model_id"/>
                            <field name="domain"/>
                        </group>
                        <group>
                            <field name="spreadsheet_id"/>
                            <field name="sheet_name"/>
                            <field name="sync_direction"/>
                            <field name="conflict_policy"/>
                            <field name="realtime_enabled"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Field Mapping">
                            <field name="field_line_ids">
                                <list editable="bottom">
                                    <field name="sequence"/>
                                    <field name="field_id"/>
                                    <field name="column_label"/>
                                    <field name="writeback_allowed"/>
                                    <field name="required_for_writeback"/>
                                    <field name="lookup_field"/>
                                </list>
                            </field>
                        </page>
                        <page string="Status">
                            <group>
                                <field name="last_success_at" readonly="1"/>
                                <field name="last_error" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_niyu_sheets_mapping" model="ir.actions.act_window">
        <field name="name">Google Sheets Mappings</field>
        <field name="res_model">niyu.sheets.mapping</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
